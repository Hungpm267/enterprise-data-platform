# ==============================================================================
# ENTERPRISE DATA PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate with your actual credentials.
# ==============================================================================

# PostgreSQL Source Database Configuration
DB_HOST=your-postgres-host.com
DB_PORT=5432
DB_NAME=ecommerce-db
DB_USER=your_db_username
DB_PASSWORD=your_secure_password
DB_SCHEMA=public

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=data-engineering-504901
GCP_GCS_BUCKET=ecommerce-data-lake-504901
GCP_STAGING_DATASET=staging
GCP_MARTS_DATASET=marts
GCP_KEY_FILE=gcp_key.json
# Production deploy (Render, etc.): paste the full service-account JSON as a
# single-line string here instead of shipping gcp_key.json.
GCP_SA_KEY=

# ==============================================================================
# WEB PORTAL (src/web) - FastAPI app configuration
# ==============================================================================

# JWT signing secret. REQUIRED in production — there is no safe default.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_secret

# Aiven.io Production PostgreSQL App Database (portal users/tenants).
# Leave unset for local dev to fall back to a local SQLite file.
APP_DB_HOST=
APP_DB_PORT=24878
APP_DB_NAME=dashgrow_app_db
APP_DB_USER=avnadmin
APP_DB_PASSWORD=
APP_DB_SSL_MODE=require

# Comma-separated list of allowed CORS origins for the web portal, e.g.
# https://your-domain.com,https://your-app.onrender.com
# Unset -> "*" (fine for local dev only; set explicitly in production).
ALLOWED_ORIGINS=

# CoinGecko Crypto API Configuration (Demo/Pro key)
COINGECKO_API_KEY=CG-your-api-key-here

# Telegram Alerting Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Prefect Cloud Orchestration (Optional for local runs)
PREFECT_API_KEY=pnu_your_prefect_api_key_here
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/your-account-id/workspaces/your-workspace-id
