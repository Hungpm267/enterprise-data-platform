    when not matched then insert
        (`order_id`, `customer_id`, `order_status`, `order_purchase_timestamp`, `total_items`, `total_order_value`, `total_freight_value`)
    values
        (`order_id`, `customer_id`, `order_status`, `order_purchase_timestamp`, `total_items`, `total_order_value`, `total_freight_value`)


    
